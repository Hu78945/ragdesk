# Optional. Without it, ragdesk answers with the offline extractive answerer.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Postgres + pgvector. Unset = in-memory store (data lost on restart).
DATABASE_URL=postgresql://ragdesk:ragdesk@localhost:5432/ragdesk

# fastembed (BAAI/bge-small-en-v1.5, local ONNX) or hash (deterministic, no download)
EMBEDDER=fastembed
# 1 = rerank hybrid candidates with a local cross-encoder (~0.4 s/query on CPU)
RERANK=0
TOP_K=5
# Cosine-similarity floor for the "I don't know" gate (default depends on embedder)
# MIN_SIMILARITY=0.65
SEED_CORPUS=1
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
